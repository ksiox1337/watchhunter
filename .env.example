# ──────────────────────────────────────────────────────────────────────────────
# eBay
# ──────────────────────────────────────────────────────────────────────────────
# If you have API access (https://developer.ebay.com), set EBAY_USE_API=true
# and provide credentials. Otherwise the system falls back to the HTML adapter.
EBAY_USE_API=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Production endpoints: https://api.ebay.com  /  https://api.ebay.com/identity/v1/oauth2/token
EBAY_OAUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_API_BASE_URL=https://api.ebay.com
# Comma-separated marketplaces. EBAY_US covers "Wristwatches"; EBAY_DE covers "Armbanduhren".
EBAY_MARKETPLACES=EBAY_US,EBAY_DE
# eBay category IDs: 31387 = Wristwatches (US), 260324 = Armbanduhren (DE)
EBAY_CATEGORY_IDS=31387,260324
# Search keywords used by both API and HTML adapters
EBAY_KEYWORDS=watch,wristwatch,armbanduhr
# HTML adapter: how many result pages to scan per (marketplace, keyword)
EBAY_HTML_PAGES_PER_QUERY=2

# ──────────────────────────────────────────────────────────────────────────────
# Gemini (https://aistudio.google.com/apikey)
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_IMAGES_PER_LISTING=4
# Requests per minute; free tier is ~5 rpm for 2.5 Pro
GEMINI_RATE_LIMIT_RPM=5

# ──────────────────────────────────────────────────────────────────────────────
# Telegram (talk to @BotFather, then send a message to your bot and find chat_id)
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/watchhunter.db
SCAN_INTERVAL_MINUTES=15
NOTIFY_INTERVAL_MINUTES=60
MIN_SCORE=60
AUCTION_ENDS_WITHIN_HOURS=24
# Skip re-analyzing the same listing within this window
REANALYSIS_TTL_HOURS=6
LOG_LEVEL=INFO
LOG_JSON=true
