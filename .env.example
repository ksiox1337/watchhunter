# ──────────────────────────────────────────────────────────────────────────────
# eBay
# ──────────────────────────────────────────────────────────────────────────────
# If you have API access (https://developer.ebay.com), set EBAY_USE_API=true
# and provide credentials. Otherwise the system falls back to the HTML adapter.
EBAY_USE_API=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Production endpoints: https://api.ebay.com  /  https://api.ebay.com/identity/v1/oauth2/token
EBAY_OAUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_API_BASE_URL=https://api.ebay.com
# Comma-separated marketplaces. EBAY_US covers "Wristwatches"; EBAY_DE covers "Armbanduhren".
EBAY_MARKETPLACES=EBAY_US,EBAY_DE
# eBay category IDs: 31387 = Wristwatches (US), 260324 = Armbanduhren (DE)
EBAY_CATEGORY_IDS=31387,260324
# Search keywords used by both API and HTML adapters
EBAY_KEYWORDS=watch,wristwatch,armbanduhr
# HTML adapter: how many result pages to scan per (marketplace, keyword)
EBAY_HTML_PAGES_PER_QUERY=2

# ──────────────────────────────────────────────────────────────────────────────
# OpenAI (https://platform.openai.com/api-keys)
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint; leave empty for api.openai.com
OPENAI_BASE_URL=
# Deep multimodal evaluation of the few listings that pass triage
OPENAI_MODEL=gpt-5-mini
# Text-only triage of titles, batched TRIAGE_BATCH_SIZE per call
OPENAI_TRIAGE_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal
# low = ~85 tokens per image; high = finer detail, ~9x the image tokens
OPENAI_IMAGE_DETAIL=low
OPENAI_RATE_LIMIT_RPM=300
OPENAI_TRIAGE_RATE_LIMIT_RPM=300
# Triage provider: openai | jev (TypeSafe decision model, falls back to openai)
TRIAGE_PROVIDER=openai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.3
MAX_IMAGES_PER_LISTING=4
TRIAGE_BATCH_SIZE=25
EVAL_CONCURRENCY=8
# Hard daily spend cap in USD (0 = no cap)
MAX_DAILY_COST_USD=1

# ──────────────────────────────────────────────────────────────────────────────
# Telegram (talk to @BotFather, then send a message to your bot and find chat_id)
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/watchhunter.db
SCAN_INTERVAL_MINUTES=15
NOTIFY_INTERVAL_MINUTES=60
MIN_SCORE=60
AUCTION_ENDS_WITHIN_HOURS=24
# Skip re-analyzing the same listing within this window
REANALYSIS_TTL_HOURS=6
LOG_LEVEL=INFO
LOG_JSON=true
# Only notify references at least this rare: low | medium | high | very_high (empty = all)
MIN_RARITY=
# Only notify when estimated value - price >= this (EUR)
MIN_PROFIT_EUR=30
# Cap on price + shipping (EUR)
MAX_TOTAL_EUR=
